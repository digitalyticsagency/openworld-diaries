# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# ElevenLabs voice IDs, one per persona
ELEVEN_VOICE_PLAYER=
ELEVEN_VOICE_CHARACTER=
ELEVEN_VOICE_COMPANION=

# Model IDs (override if yours differ)
GEMINI_MODEL=gemini-3.8-flash
CLAUDE_MODEL=claude-opus-5-5
ELEVEN_MODEL=eleven_multilingual_v2

# Google OAuth client file (downloaded from Google Cloud console)
GOOGLE_CLIENT_SECRET=client_secret.json
